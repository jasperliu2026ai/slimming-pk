generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  openid          String       @unique @db.VarChar(128)
  unionid         String?      @unique @db.VarChar(128)
  nickname        String       @default("") @db.VarChar(32)
  avatarUrl       String       @default("") @db.VarChar(500)
  gender          Gender       @default(unknown)
  heightCm        Int?
  targetWeightKg  Decimal?     @db.Decimal(5, 2)
  currentWeightKg Decimal?     @db.Decimal(5, 2)
  privacyAgreedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdRooms    PkRoom[]     @relation("RoomCreator")
  roomMemberships RoomMember[]
  checkins        Checkin[]

  @@map("users")
}

model PkRoom {
  id           String       @id @default(cuid())
  inviteCode   String       @unique @db.VarChar(12)
  name         String       @db.VarChar(20)
  status       RoomStatus   @default(pending)
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  durationDays Int
  maxMembers   Int          @default(5)
  creatorId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  creator      User         @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members      RoomMember[]
  checkins     Checkin[]

  @@index([creatorId, createdAt])
  @@index([status, startDate])
  @@map("pk_rooms")
}

model RoomMember {
  roomId          String
  userId          String
  initialWeightKg Decimal      @db.Decimal(5, 2)
  initialPhotoKey String       @map("initialPhotoUrl") @db.VarChar(500)
  currentWeightKg Decimal      @db.Decimal(5, 2)
  joinedAt        DateTime     @default(now())
  status          MemberStatus @default(active)
  room            PkRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId, status])
  @@map("room_members")
}

model Checkin {
  id                String   @id @default(cuid())
  roomId            String
  userId            String
  checkinDate       DateTime @db.Date
  weightKg          Decimal? @db.Decimal(5, 2)
  weightPhotoKey    String?  @map("weightPhotoUrl") @db.VarChar(500)
  dietText          String?  @db.VarChar(200)
  dietPhotoUrls     Json
  exerciseText      String?  @db.VarChar(200)
  exercisePhotoUrls Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  room              PkRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, checkinDate])
  @@index([userId, checkinDate])
  @@index([roomId, checkinDate])
  @@map("checkins")
}

model FundLedger {
  id          String   @id @default(cuid())
  userId      String
  bizType     BizType
  bizId       String
  amountCent  Int
  balanceCent Int
  remark      String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bizType, bizId])
  @@map("fund_ledger")
}

enum Gender {
  male
  female
  unknown
}

enum RoomStatus {
  pending
  active
  ended
  dissolved
}

enum MemberStatus {
  active
  withdrawn
}

enum BizType {
  deposit
  refund
  reward
  penalty
  adjust
}
